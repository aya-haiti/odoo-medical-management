<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- RÈGLES POUR LE MÉDECIN -->
        
        <!-- Le médecin voit uniquement SES rendez-vous -->
        <record id="appointment_doctor_own_rule" model="ir.rule">
            <field name="name">Rendez-vous: Médecin voit ses propres RDV</field>
            <field name="model_id" ref="model_clinic_appointment"/>
            <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_clinic_doctor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Le médecin voit uniquement SES consultations -->
        <record id="consultation_doctor_own_rule" model="ir.rule">
            <field name="name">Consultation: Médecin voit ses propres consultations</field>
            <field name="model_id" ref="model_clinic_consultation"/>
            <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_clinic_doctor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- Le médecin voit uniquement SES ordonnances -->
        <record id="prescription_doctor_own_rule" model="ir.rule">
            <field name="name">Ordonnance: Médecin voit ses propres ordonnances</field>
            <field name="model_id" ref="model_clinic_prescription"/>
            <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_clinic_doctor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- RÈGLES POUR LA RÉCEPTION -->
        
        <!-- La réception voit tous les rendez-vous -->
        <record id="appointment_reception_all_rule" model="ir.rule">
            <field name="name">Rendez-vous: Réception voit tous les RDV</field>
            <field name="model_id" ref="model_clinic_appointment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_clinic_reception'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- La réception voit tous les patients -->
        <record id="patient_reception_all_rule" model="ir.rule">
            <field name="name">Patient: Réception voit tous les patients</field>
            <field name="model_id" ref="model_clinic_patient"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_clinic_reception'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- Le médecin voit tous les patients (lecture seule) -->
        <record id="patient_doctor_all_rule" model="ir.rule">
            <field name="name">Patient: Médecin voit tous les patients</field>
            <field name="model_id" ref="model_clinic_patient"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_clinic_doctor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
    </data>
</odoo>