<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vue Graphique : RDV par Médecin -->
    <record id="view_appointment_graph" model="ir.ui.view">
        <field name="name">clinic.appointment.graph</field>
        <field name="model">clinic.appointment</field>
        <field name="arch" type="xml">
            <graph string="Rendez-vous par Médecin" type="bar">
                <field name="doctor_id"/>
                <field name="priority" type="col"/>
            </graph>
        </field>
    </record>
    
    <!-- Vue Pivot : Statistiques -->
    <record id="view_appointment_pivot" model="ir.ui.view">
        <field name="name">clinic.appointment.pivot</field>
        <field name="model">clinic.appointment</field>
        <field name="arch" type="xml">
            <pivot string="Statistiques RDV">
                <field name="appointment_date" type="row" interval="month"/>
                <field name="doctor_id" type="col"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>
    
    <!-- Action Dashboard -->
    <record id="action_clinic_dashboard" model="ir.actions.act_window">
        <field name="name">📊 Tableau de Bord</field>
        <field name="res_model">clinic.appointment</field>
        <field name="view_mode">graph,pivot,tree,kanban</field>
        <field name="context">{}</field>
    </record>
    
    <!-- Menu Dashboard -->
    <menuitem id="menu_clinic_dashboard" 
              name="📊 Tableau de Bord" 
              parent="menu_clinic_root" 
              action="action_clinic_dashboard" 
              sequence="5"/>
    
</odoo>