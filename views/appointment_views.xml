<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vue Kanban Appointment (ATTRACTIVE avec URGENT en ROUGE) -->
    <record id="view_appointment_kanban" model="ir.ui.view">
        <field name="name">clinic.appointment.kanban</field>
        <field name="model">clinic.appointment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false">
                <field name="color"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="display_time"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="patient_phone"/>
                <field name="reason"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_card oe_kanban_global_click #{record.priority.raw_value === 'urgent' ? 'border-danger' : ''}">
                            <div class="oe_kanban_content">
                                <!-- En-tête avec priorité -->
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="reference"/>
                                            <t t-if="record.priority.raw_value === 'urgent'">
                                                <span class="badge badge-danger ml-1">🚨 URGENT</span>
                                            </t>
                                        </strong>
                                    </div>
                                </div>
                                
                                <!-- Corps de la carte -->
                                <div class="o_kanban_record_body mt-2">
                                    <div>
                                        <i class="fa fa-user text-primary"/> <strong><field name="patient_id"/></strong>
                                    </div>
                                    <div class="mt-1">
                                        <i class="fa fa-user-md text-success"/> <field name="doctor_id"/>
                                    </div>
                                    <div class="mt-1">
                                        <i class="fa fa-calendar text-info"/> <field name="appointment_date"/>
                                        <i class="fa fa-clock-o text-warning ml-2"/> <field name="display_time"/>
                                    </div>
                                    <div class="mt-1">
                                        <i class="fa fa-phone text-muted"/> <field name="patient_phone"/>
                                    </div>
                                    <t t-if="record.reason.raw_value">
                                        <div class="mt-2 text-muted small">
                                            <em><field name="reason"/></em>
                                        </div>
                                    </t>
                                </div>
                                
                                <!-- Pied de carte -->
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="state" widget="label_selection" options="{'classes': {'waiting': 'warning', 'with_doctor': 'info', 'done': 'success', 'cancelled': 'danger'}}"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="email_sent" widget="boolean_toggle" invisible="1"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Vue Tree Appointment (AVEC COULEURS) -->
    <record id="view_appointment_tree" model="ir.ui.view">
        <field name="name">clinic.appointment.tree</field>
        <field name="model">clinic.appointment</field>
        <field name="arch" type="xml">
            <tree string="Rendez-vous" 
                  decoration-danger="priority=='urgent' and state not in ['done', 'cancelled']"
                  decoration-muted="state=='cancelled'" 
                  decoration-success="state=='done'"
                  decoration-info="state=='with_doctor'"
                  sample="1">
                <field name="reference" decoration-bf="1"/>
                <field name="appointment_date"/>
                <field name="display_time" string="Heure"/>
                <field name="patient_id"/>
                <field name="patient_phone" optional="show"/>
                <field name="doctor_id"/>
                <field name="doctor_specialization" optional="hide"/>
                <field name="priority" widget="badge" decoration-danger="priority=='urgent'" decoration-success="priority=='normal'"/>
                <field name="state" widget="badge" 
                       decoration-warning="state=='waiting'" 
                       decoration-info="state=='with_doctor'" 
                       decoration-success="state=='done'" 
                       decoration-danger="state=='cancelled'"/>
                <field name="email_sent" widget="boolean" optional="hide"/>
                <field name="color" invisible="1"/>
            </tree>
        </field>
    </record>
    
    <!-- Vue Form Appointment (ATTRACTIVE) -->
    <record id="view_appointment_form" model="ir.ui.view">
        <field name="name">clinic.appointment.form</field>
        <field name="model">clinic.appointment</field>
        <field name="arch" type="xml">
            <form string="Rendez-vous Médical">
                <header>
                    <!-- Boutons d'action -->
                    <button name="action_set_waiting" string="⏸️ En Attente" type="object" states="cancelled" class="oe_highlight"/>
                    <button name="action_set_with_doctor" string="👨‍⚕️ Chez le Médecin" type="object" states="waiting" class="oe_highlight" groups="clinic.group_clinic_doctor"/>
                    <button name="action_create_consultation" string="📋 Démarrer Consultation" type="object" states="waiting,with_doctor" class="oe_highlight" groups="clinic.group_clinic_doctor"/>
                    <button name="action_set_done" string="✅ Terminer" type="object" states="waiting,with_doctor" groups="clinic.group_clinic_doctor"/>
                    <button name="action_cancel" string="❌ Annuler" type="object" states="waiting,with_doctor" confirm="Êtes-vous sûr de vouloir annuler ce rendez-vous?"/>
                    <button name="action_resend_email" string="📧 Renvoyer Email" type="object" states="waiting" attrs="{'invisible': [('email_sent', '=', False)]}" groups="clinic.group_clinic_reception"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="waiting,with_doctor,done"/>
                </header>
                
                <sheet>
                    <!-- Titre avec référence -->
                    <div class="oe_title">
                        <h1>
                            <field name="reference" readonly="1"/>
                        </h1>
                    </div>
                    
                    <!-- Badge URGENT si nécessaire -->
                    <div class="ribbon ribbon-top-right" attrs="{'invisible': [('priority', '!=', 'urgent')]}">
                        <span class="bg-danger">🚨 URGENT</span>
                    </div>
                    
                    <group>
                        <group string="👤 Patient">
                            <field name="patient_id" options="{'no_create': False, 'no_open': False}"/>
                            <field name="patient_phone" readonly="1" widget="phone"/>
                            <field name="patient_email" readonly="1" widget="email"/>
                            <field name="patient_age" readonly="1"/>
                        </group>
                        <group string="👨‍⚕️ Médecin">
                            <field name="doctor_id" options="{'no_create': False}"/>
                            <field name="doctor_specialization" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="📅 Date et Heure">
                            <field name="appointment_date"/>
                            <field name="appointment_time" widget="float_time"/>
                            <field name="display_time" readonly="1"/>
                            <field name="appointment_datetime" readonly="1" invisible="1"/>
                        </group>
                        <group string="⚙️ Paramètres">
                            <field name="priority" widget="radio" options="{'horizontal': true}"/>
                            <field name="email_sent" readonly="1" widget="boolean"/>
                            <field name="email_sent_date" readonly="1" attrs="{'invisible': [('email_sent', '=', False)]}"/>
                        </group>
                    </group>
                    
                    <group string="📝 Informations">
                        <field name="reason" placeholder="Motif du rendez-vous (ex: Consultation générale, suivi, urgence...)"/>
                        <field name="notes" placeholder="Notes de la réception (informations importantes)"/>
                    </group>
                    
                    <!-- Consultation liée -->
                    <group string="📋 Consultation" attrs="{'invisible': [('consultation_id', '=', False)]}" groups="clinic.group_clinic_doctor">
                        <field name="consultation_id" readonly="1"/>
                    </group>
                    
                </sheet>
                
                <!-- Chatter pour discussions -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <!-- Vue Calendar Appointment (ATTRACTIVE) -->
    <record id="view_appointment_calendar" model="ir.ui.view">
        <field name="name">clinic.appointment.calendar</field>
        <field name="model">clinic.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Calendrier des Rendez-vous" 
                      date_start="appointment_datetime" 
                      color="doctor_id" 
                      mode="week" 
                      quick_add="True"
                      event_open_popup="true"
                      form_view_id="%(view_appointment_form)d">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="display_time"/>
                <field name="priority"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>
    
    <!-- Vue Search Appointment (TRÈS COMPLET) -->
    <record id="view_appointment_search" model="ir.ui.view">
        <field name="name">clinic.appointment.search</field>
        <field name="model">clinic.appointment</field>
        <field name="arch" type="xml">
            <search string="Rechercher Rendez-vous">
                <!-- Barre de recherche -->
                <field name="reference"/>
                <field name="patient_id" string="Patient ou Téléphone" filter_domain="['|', ('patient_id', 'ilike', self), ('patient_phone', 'ilike', self)]"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                
                <!-- FILTRES PRINCIPAUX -->
                <separator/>
                <filter string="📅 Aujourd'hui" name="today" 
                        domain="[('appointment_date', '=', context_today().strftime('%Y-%m-%d'))]"
                        help="Rendez-vous d'aujourd'hui"/>
                <filter string="📆 Cette Semaine" name="this_week" 
                        domain="[('appointment_date', '&gt;=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), 
                                 ('appointment_date', '&lt;=', (context_today() + relativedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="📅 Ce Mois" name="this_month" 
                        domain="[('appointment_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d')), 
                                 ('appointment_date', '&lt;=', ((context_today().replace(day=1) + relativedelta(months=1)) - relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="🔜 À Venir" name="upcoming" 
                        domain="[('appointment_date', '&gt;=', context_today().strftime('%Y-%m-%d')), ('state', 'in', ['waiting', 'with_doctor'])]"/>
                
                <separator/>
                <filter string="🚨 URGENT" name="urgent" 
                        domain="[('priority', '=', 'urgent')]"
                        help="Rendez-vous urgents"/>
                
                <separator/>
                <filter string="⏸️ En Attente" name="waiting" 
                        domain="[('state', '=', 'waiting')]"/>
                <filter string="👨‍⚕️ Chez le Médecin" name="with_doctor" 
                        domain="[('state', '=', 'with_doctor')]"/>
                <filter string="✅ Terminés" name="done" 
                        domain="[('state', '=', 'done')]"/>
                <filter string="❌ Annulés" name="cancelled" 
                        domain="[('state', '=', 'cancelled')]"/>
                
                <separator/>
                <filter string="📧 Email Envoyé" name="email_sent" 
                        domain="[('email_sent', '=', True)]"/>
                <filter string="📧 Email Non Envoyé" name="email_not_sent" 
                        domain="[('email_sent', '=', False)]"/>
                
                <separator/>
                <filter string="📋 Avec Consultation" name="has_consultation" 
                        domain="[('consultation_id', '!=', False)]" groups="clinic.group_clinic_doctor"/>
                
                <!-- GROUPEMENTS -->
                <group expand="0" string="Grouper par">
                    <filter string="👨‍⚕️ Médecin" name="group_doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter string="📅 Date" name="group_date" context="{'group_by': 'appointment_date'}"/>
                    <filter string="📊 État" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="⚠️ Priorité" name="group_priority" context="{'group_by': 'priority'}"/>
                </group>
                
                <!-- PANEL DE RECHERCHE -->
                <searchpanel>
                    <field name="doctor_id" icon="fa-user-md" enable_counters="1"/>
                    <field name="state" select="multi" icon="fa-tasks" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>
    
    <!-- Action Appointment (Tous les RDV) -->
    <record id="action_appointment" model="ir.actions.act_window">
        <field name="name">Tous les Rendez-vous</field>
        <field name="res_model">clinic.appointment</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un nouveau rendez-vous
            </p>
            <p>
                Planifiez les rendez-vous des patients avec les médecins.
                Les emails de confirmation sont envoyés automatiquement.
            </p>
        </field>
    </record>
    
    <!-- Action SPÉCIAL: RDV du Jour (pour Réception) -->
    <record id="action_appointment_today" model="ir.actions.act_window">
        <field name="name">📅 Rendez-vous Aujourd'hui</field>
        <field name="res_model">clinic.appointment</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
        <field name="context">{'search_default_today': 1, 'search_default_group_doctor': 1}</field>
        <field name="domain">[('appointment_date', '=', context_today().strftime('%Y-%m-%d'))]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun rendez-vous aujourd'hui
            </p>
            <p>
                Créez un rendez-vous pour la journée.
            </p>
        </field>
    </record>
    
    <!-- Action: RDV Urgents -->
    <record id="action_appointment_urgent" model="ir.actions.act_window">
        <field name="name">🚨 Rendez-vous URGENTS</field>
        <field name="res_model">clinic.appointment</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_urgent': 1, 'search_default_upcoming': 1}</field>
        <field name="domain">[('priority', '=', 'urgent'), ('state', 'in', ['waiting', 'with_doctor'])]</field>
    </record>
    
    <!-- Action: Mes RDV (pour médecin connecté) -->
    <record id="action_appointment_my" model="ir.actions.act_window">
        <field name="name">👨‍⚕️ Mes Rendez-vous</field>
        <field name="res_model">clinic.appointment</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun rendez-vous
            </p>
            <p>
                Vos rendez-vous apparaîtront ici.
            </p>
        </field>
    </record>
    
</odoo>