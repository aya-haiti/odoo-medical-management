<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_prescription" model="ir.actions.report">
        <field name="name">Ordonnance</field>
        <field name="model">clinic.prescription</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">clinic.report_prescription_document</field>
        <field name="report_file">clinic.report_prescription_document</field>
        <field name="binding_model_id" ref="model_clinic_prescription"/>
        <field name="binding_type">report</field>
    </record>
    
    <template id="report_prescription_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">ORDONNANCE MÉDICALE</h2>
                        <p class="text-center"><strong><span t-field="o.reference"/></strong></p>
                        
                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Médecin:</strong><br/>
                                Dr. <span t-field="o.doctor_id.name"/><br/>
                                <span t-field="o.doctor_id.specialization"/>
                            </div>
                            <div class="col-6">
                                <strong>Patient:</strong><br/>
                                <span t-field="o.patient_id.name"/><br/>
                                <span t-field="o.patient_id.phone"/>
                            </div>
                        </div>
                        
                        <h4 class="mt-4">Prescription:</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Médicament</th>
                                    <th>Dosage</th>
                                    <th>Fréquence</th>
                                    <th>Durée</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.medicine_id.name"/></td>
                                    <td><span t-field="line.dosage"/></td>
                                    <td><span t-field="line.frequency"/></td>
                                    <td><span t-field="line.duration"/></td>
                                </tr>
                            </tbody>
                        </table>
                        
                        <div class="text-right mt-5">
                            <p>Signature:<br/><strong>Dr. <span t-field="o.doctor_id.name"/></strong></p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>