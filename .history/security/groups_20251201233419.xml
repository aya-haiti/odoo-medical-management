<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Catégorie du module -->
        <record id="module_category_clinic" model="ir.module.category">
            <field name="name">Cabinet Médical</field>
            <field name="description">Gestion d'un Cabinet Médical</field>
            <field name="sequence">10</field>
        </record>
        
        <!-- Groupe RÉCEPTION (Accueil/Secrétariat) -->
        <record id="group_clinic_reception" model="res.groups">
            <field name="name">Réception</field>
            <field name="category_id" ref="module_category_clinic"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Rôle Réception - Accès à:
                - Gestion des rendez-vous (CRUD complet)
                - Gestion des patients (CRUD complet)
                - Vue liste des médecins (lecture seule)
            </field>
        </record>
        
        <!-- Groupe MÉDECIN -->
        <record id="group_clinic_doctor" model="res.groups">
            <field name="name">Médecin</field>
            <field name="category_id" ref="module_category_clinic"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Rôle Médecin - Accès à:
                - Consultations médicales (CRUD complet)
                - Ordonnances (CRUD complet)
                - Vue des rendez-vous (ses RDV uniquement)
                - Vue des patients (lecture seule)
            </field>
        </record>
        
        <!-- Groupe MANAGER (Administrateur Cabinet) -->
        <record id="group_clinic_manager" model="res.groups">
            <field name="name">Manager Cabinet</field>
            <field name="category_id" ref="module_category_clinic"/>
            <field name="implied_ids" eval="[(4, ref('group_clinic_reception')), (4, ref('group_clinic_doctor'))]"/>
            <field name="comment">
                Rôle Manager - Accès complet à toutes les fonctionnalités
            </field>
        </record>
        
    </data>
</odoo>